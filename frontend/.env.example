# Copy to frontend/.env.local if you need to change it. Placeholders only - never put secrets in the frontend.
# Base URL of the backend API. The default "/api" works with the Vite dev proxy (backend on localhost:8000).
VITE_API_BASE_URL=/api
# Production (Vercel): set this in the Vercel project settings, e.g.
# VITE_API_BASE_URL=https://css-coach-api.onrender.com/api
