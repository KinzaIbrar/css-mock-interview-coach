# Copy to backend/.env and fill in. NEVER commit .env.
APP_ENV=development
DATABASE_URL=sqlite:///./app.db
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173
# Get a key at https://aistudio.google.com (leave empty for labelled dev mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional overrides (defaults shown)
# QUESTIONS_PATH=../data/questions
# RETRIEVAL_BACKEND=keyword
# Gemini call policy (defaults shown): per-attempt timeout, retries on 5xx/429/timeouts, total budget, cooldown after failure
# GEMINI_TIMEOUT_SECONDS=30
# GEMINI_MAX_RETRIES=2
# GEMINI_RETRY_DELAY_SECONDS=2
# GEMINI_BUDGET_SECONDS=65
# GEMINI_COOLDOWN_SECONDS=30
# MAX_FOLLOW_UPS_PER_INTERVIEW=3
